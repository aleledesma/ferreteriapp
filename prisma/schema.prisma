// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppRole {
  id              BigInt              @id @default(autoincrement())
  name            String              @unique @db.Text
  isSystem        Boolean             @default(true) @map("is_system")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  rolePermissions AppRolePermission[]
  userRoles       AppUserRole[]

  @@map("app_roles")
}

model AppPermission {
  id              BigInt              @id @default(autoincrement())
  name            String              @unique @db.Text
  description     String?             @db.Text
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  rolePermissions AppRolePermission[]

  @@map("app_permissions")
}

model AppRolePermission {
  roleId       BigInt       @map("role_id")
  permissionId BigInt       @map("permission_id")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  role         AppRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AppPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId], map: "idx_app_role_permissions_role_id")
  @@index([permissionId], map: "idx_app_role_permissions_permission_id")
  @@map("app_role_permissions")
}

model AppUserRole {
  userId    String   @id @map("user_id") @db.Uuid
  roleId    BigInt   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  role      AppRole  @relation(fields: [roleId], references: [id])

  @@index([roleId], map: "idx_app_user_roles_role_id")
  @@map("app_user_roles")
}
